# Optional configuration for the GIS Helper MCP server.
# Copy to .env for local development. No secrets required.

# Host/port for the companion HTTP "map bridge" that serves the Leaflet drawing
# page and receives drawn geometry. Defaults to 127.0.0.1:8765.
# GIS_HELPER_MAP_HOST=127.0.0.1
# GIS_HELPER_MAP_PORT=8765

# Public origin the browser should use to reach the map bridge. Set this when the
# server runs behind a proxy or in a container (e.g. https://gis-helper.example.gov).
# Defaults to http://<GIS_HELPER_MAP_HOST>:<GIS_HELPER_MAP_PORT>.
# GIS_HELPER_PUBLIC_URL=

# Leaflet basemap tile URL template. Defaults to OpenStreetMap.
# Example USGS National Map imagery:
#   https://basemap.nationalmap.gov/arcgis/rest/services/USGSImageryOnly/MapServer/tile/{z}/{y}/{x}
# GIS_HELPER_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# GIS_HELPER_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# When running as a deployed HTTP MCP server, a platform port env var selects the
# HTTP transport for MCP itself (mirrors the FEMA/USGS servers).
# PORT=8080
